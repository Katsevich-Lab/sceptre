digraph analysis {
  graph [rankdir=TB, bgcolor="transparent", pad="0.18", nodesep="0.45", ranksep="0.45", fontname="Helvetica", splines=polyline];
  node [shape=box, style="rounded,filled", fillcolor="#F1F5FA", color="#92A7BF", fontname="Helvetica", fontsize=18, margin="0.22,0.14", penwidth=1.3];
  edge [color="#526C8B", arrowsize=0.8, penwidth=1.5];
  start [label=< <B>1. Start discovery analysis</B><BR/>run_discovery_analysis()<BR/><FONT POINT-SIZE="13">s4_analysis_functs_2.R</FONT> >, fillcolor="#DAE8FA", color="#4E75A5"];
  prepare [label=< <B>2. Prepare the requested tests</B><BR/>Keep eligible pairs; select and order cells<BR/><FONT POINT-SIZE="13">analysis.R · analysis_context.R</FONT> >];
  plan [label=< <B>3. Choose how to visit the pairs</B><BR/>Permutation: by response · CRT: by guide<BR/><FONT POINT-SIZE="13">association_execution.R</FONT> >];
  test [label=< <B>4. Prepare the numerical inputs</B><BR/>Counts, fitted means and test inputs<BR/><FONT POINT-SIZE="13">association_workers.R</FONT> >];
  native [label=< <B>5. Calculate effects and p-values</B><BR/>Score, resampling stages and tail calculation<BR/><FONT POINT-SIZE="13">src/inference_*.cpp · low_level_full_test.cpp</FONT> >, fillcolor="#E4F1E8", color="#659576"];
  finish [label=< <B>6. Assemble and save the results</B><BR/>Restore pair order; integrate guides<BR/>Apply multiple-testing correction<BR/><FONT POINT-SIZE="13">result_processing.R · public analysis functions</FONT> >];
  saved [label=< <B>Updated sceptre_object</B><BR/>Results and reusable response fits >, fillcolor="#DAE8FA", color="#4E75A5"];
  storage [label=< <B>Read counts</B><BR/>R sparse matrix or ondisc file<BR/><FONT POINT-SIZE="13">storage.R</FONT> >, fillcolor="#FAF4E5", color="#B6A06A"];
  fits [label=< <B>Fit models and prepare scores</B><BR/>Statistical calculations in small functions<BR/><FONT POINT-SIZE="13">fitting.R · score_preparation.R</FONT> >, fillcolor="#FAF4E5", color="#B6A06A"];
  cache [label=< <B>Reuse a previous response fit?</B><BR/>Clear fits when their inputs change<BR/><FONT POINT-SIZE="13">fit_cache.R</FONT> >, fillcolor="#FAF4E5", color="#B6A06A"];
  start -> prepare -> plan -> test -> native -> finish -> saved;
  {rank=same; plan; cache;}
  {rank=same; test; storage;}
  {rank=same; native; fits;}
  cache -> plan [style=dashed, color="#AA9058", constraint=false];
  storage -> test [style=dashed, color="#AA9058", constraint=false];
  fits -> test [style=dashed, color="#AA9058", constraint=false];
  cache -> storage -> fits [style=invis];
}
